# Postgres connection string, must point at a database with the PostGIS extension available.
DATABASE_URL="postgresql://user:password@localhost:5432/leveebuddy?schema=public"

# Twilio - SMS delivery. The from number is tied to a levee's own A2P 10DLC
# campaign registration, so there's no shared default to fall back to.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Postmark - email delivery. The from address must already be a verified
# sender signature or domain in the Postmark account.
POSTMARK_SERVER_TOKEN=""
POSTMARK_FROM_EMAIL=""
