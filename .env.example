# Postgres connection string, must point at a database with the PostGIS extension available.
DATABASE_URL="postgresql://user:password@localhost:5432/leveebuddy?schema=public"

# Twilio - SMS delivery. The from number is tied to a levee's own A2P 10DLC
# campaign registration, so there's no shared default to fall back to.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Postmark - email delivery. The from address must already be a verified
# sender signature or domain in the Postmark account.
POSTMARK_SERVER_TOKEN=""
POSTMARK_FROM_EMAIL=""

# Vercel Blob - document storage. Uploads go straight from the browser to
# Blob, so this token only needs read-write scope on the store attached to
# this project. Create a store from the Vercel dashboard's Storage tab.
BLOB_READ_WRITE_TOKEN=""

# Session cookie signing key. Generate with: openssl rand -base64 32
SESSION_SECRET=""

# The apex domain proxy.ts strips subdomains against. Only needed in
# .env.example's absence - defaults to leveebuddy.com.
ROOT_DOMAIN="leveebuddy.com"
